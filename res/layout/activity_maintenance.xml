<?xml version="1.0" encoding="utf-8"?>
<!--
  维护界面：内容容器默认隐藏；PIN 校验通过（或未设置 PIN）后才显示。
  只用 TextView / Button / ScrollView / LinearLayout。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/maintenance_title"
            android:textColor="@color/terminal_accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ll_maintenance_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/maintenance_diagnostics_title"
                android:textColor="@color/terminal_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_diagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/terminal_text"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_retry_termux"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/action_retry_termux" />

            <Button
                android:id="@+id/btn_exit_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_exit_lock" />

            <Button
                android:id="@+id/btn_set_pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_set_pin" />

            <!-- 仅 Android 16+ 且 Device Owner 时显示（MaintenanceActivity 控制可见性）。 -->
            <Button
                android:id="@+id/btn_request_supervision_role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_request_supervision_role"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_open_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_open_settings" />

            <TextView
                android:id="@+id/tv_exit_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/maintenance_exit_note"
                android:textColor="@color/terminal_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_pin_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/maintenance_pin_note"
                android:textColor="@color/terminal_warning"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
